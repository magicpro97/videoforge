{
  "name": "videoforge",
  "version": "1.1.0",
  "description": "AI Video Generator CLI — Multi-provider text-to-video and image-to-video generation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "videoforge": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "vitest run --coverage --pool=forks --poolOptions.forks.maxForks=1",
    "test:watch": "vitest --pool=forks --poolOptions.forks.maxForks=1"
  },
  "keywords": [
    "ai",
    "video",
    "generator",
    "cli",
    "text-to-video",
    "image-to-video",
    "runway",
    "sora",
    "veo"
  ],
  "author": "magicpro97",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "inquirer": "^13.3.2",
    "ora": "^9.3.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^3.1.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/magicpro97/videoforge"
  }
}
